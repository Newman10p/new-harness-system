{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/types/**/*",
    "src/core/**/*",
    "src/actions/**/*",
    "src/security/**/*",
    "src/ui/**/*",
    "src/auth/**/*",
    "src/gateway/**/*",
    "src/sandbox/**/*",
    "src/sandbox2/**/*",
    "src/config/**/*",
    "src/harness/**/*",
    "src/registry/**/*",
    "src/policy/**/*",
    "src/server.ts",
    "src/index.ts",
    "src/config.ts",
    "src/startup.ts"
  ],
  "exclude": ["node_modules", "dist"]
}