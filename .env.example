# M.A.I. Harness Configuration

# Primary LLM Provider (OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_PROVIDER=ollama

# OpenRouter Fallback (Optional - for free GLM-5.2 access)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Additional Fallback Providers (Optional)
# LLM_FALLBACK_1_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_1_API_KEY=your_openai_key
# LLM_FALLBACK_1_MODEL=gpt-4o-mini
# LLM_FALLBACK_1_PROVIDER=openai

# Server Configuration
HTTP_PORT=3000
WS_PORT=8080

# Audio Configuration (Optional)
AUDIO_MODE=disabled
# AUDIO_MODE=speaker
# AUDIO_MODE=headset

# Vault Path
VAULT_PATH=./vault
