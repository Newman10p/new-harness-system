# ─── M.A.I. Environment Configuration ──────────────────────────────────────
# Copy this to .env and fill in your values.
# cp .env.example .env

# ─── LLM Configuration ──────────────────────────────────────────────────────
# Base URL for OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434/v1

# API Key (use "ollama" for local Ollama, or your OpenAI/NVIDIA key)
LLM_API_KEY=ollama

# Model name
LLM_MODEL=llama3.2

# Provider name (for display/logging)
LLM_PROVIDER=ollama

# ─── Server Ports ──────────────────────────────────────────────────────────
# HTTP file server (serves public/)
HTTP_PORT=3000

# WebSocket HUD server
WS_PORT=8080
