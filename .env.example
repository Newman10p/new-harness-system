# ─── M.A.I. Environment Configuration ──────────────────────────────────────
# Copy this to .env and fill in your values.
# cp .env.example .env

# ─── LLM Configuration ──────────────────────────────────────────────────────
# Choose ONE provider section and uncomment it.

# ── Local Ollama (default) ────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_PROVIDER=ollama

# ── Ollama Cloud ───────────────────────────────────────────────────────────
# Get your API key from https://cloud.ollama.com
# IMPORTANT: Ollama Cloud uses native /api/chat (not OpenAI-compatible).
# The system auto-detects LLM_PROVIDER=ollama-cloud and uses the correct endpoint.
# Available models: gemma4:31b, qwen3.5:397b, deepseek-v4-pro, kimi-k3, etc.
# LLM_BASE_URL=https://api.ollama.com
# LLM_API_KEY=oll-cloud-xxxxxxxxxxxxxxxx
# LLM_MODEL=gemma4:31b
# LLM_PROVIDER=ollama-cloud

# ── OpenAI ────────────────────────────────────────────────────────────────
# Get your API key from https://platform.openai.com/api-keys
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# ── NVIDIA NIM ────────────────────────────────────────────────────────────
# Get your API key from https://build.nvidia.com
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-your-key-here
# LLM_MODEL=meta/llama3-70b-instruct
# LLM_PROVIDER=nvidia

# ── Anthropic (via OpenAI-compatible proxy) ─────────────────────────────────
# LLM_BASE_URL=https://your-anthropic-proxy/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=claude-3-haiku-20240307
# LLM_PROVIDER=anthropic

# ── OpenCode Zen (pay-as-you-go) ───────────────────────────────────────────
# Gateway to 75+ models via OpenCode's unified API.
# Get your API key from https://opencode.ai — sign in, then visit the Zen page.
# Models using OpenAI Chat Completions: gpt-5.5, gpt-5.4, grok-4.5, deepseek-v4-pro,
#   glm-5.2, kimi-k3, minimax-m3, and more.
# Models using Anthropic Messages: claude-opus-5, claude-sonnet-5, qwen3.7-max, etc.
# The system auto-detects the endpoint format based on model name.
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_API_KEY=oc-zen-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-5.5
# LLM_PROVIDER=opencode-zen

# ── OpenCode Go ($10/month subscription) ───────────────────────────────────
# Unlimited* access to curated models: kimi-k3, deepseek-v4-pro, grok-4.5,
#   glm-5.2, minimax-m3, qwen3.7-max, qwen3.8-max, and more.
# Get your API key from https://opencode.ai — Go subscription page.
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=oc-go-xxxxxxxxxxxxxxxx
# LLM_MODEL=kimi-k3
# LLM_PROVIDER=opencode-go

# ─── LLM Fallback Providers ────────────────────────────────────────────────
# Add up to 4 fallback providers. Each needs all 4 env vars.
# Priority order: Fallback 1 is tried first, then 2, 3, 4.
# LLM_FALLBACK_1_BASE_URL=https://opencode.ai/zen/v1
# LLM_FALLBACK_1_API_KEY=oc-zen-xxxxxxxxxxxxxxxx
# LLM_FALLBACK_1_MODEL=gpt-5.5
# LLM_FALLBACK_1_PROVIDER=opencode-zen

# ─── Native Tool Calling ──────────────────────────────────────────────────
# Use OpenAI-compatible function calling instead of regex JSON block parsing.
# Automatically disabled for Ollama native and OpenCode Anthropic providers.
# Set to "false" to force regex parsing for all providers.
NATIVE_TOOL_CALLING=true

# ─── LLM Budget Governor ──────────────────────────────────────────────────
# Prevents runaway LLM costs from autonomous subsystems (proactive engine,
# self-improvement, scheduled tasks, macros). User-initiated calls always pass.
LLM_DAILY_BUDGET=500
LLM_HOURLY_RATE=60

# ─── Multi-Model Router (Brain / Router / Hands) ─────────────────────────────
# The router enables Mai to use different models for different tasks:
#   - Brain:  The large model (e.g. 120B) for reasoning, planning, personality
#   - Router: A small local model (e.g. 1.2B) for message classification + simple Q&A
#   - Hands:  A code-focused model (e.g. Qwen Coder) for code generation
#
# WITHOUT these vars: brain handles everything (backward-compatible).
# WITH these vars: the router classifies messages and delegates accordingly.
#
# OPTION 1: Explicit configuration (full control)
# ────────────────────────────────────────────────────────────────────────
# ROUTER_MODEL=llama3.2:1b          # Small model for classification
# ROUTER_BASE_URL=http://localhost:11434/v1
# ROUTER_API_KEY=ollama              # Local Ollama doesn't need a real key
# HANDS_MODEL=qwen2.5-coder:7b       # Code-focused model
# HANDS_BASE_URL=http://localhost:11434/v1
# HANDS_API_KEY=ollama
#
# OPTION 2: Auto-detection (recommended for local Ollama)
# ────────────────────────────────────────────────────────────────────────
# Just set OLLAMA_ENDPOINT and the router will scan /api/tags for suitable models.
# Models under 4GB are candidates for router, models with "coder" in the name
# are candidates for hands. Explicit ROUTER_*/HANDS_* vars take priority.
# OLLAMA_ENDPOINT=http://localhost:11434
#
# ROUTER_AUTO_DETECT=true             # Set to "false" to disable auto-detection
# ROUTER_MIN_CONFIDENCE=0.6            # 0.0-1.0, only route to small models above this

# ─── Vision Language Model (VLM) ──────────────────────────────────────────
# Used by analyze-image and screenshot-capture (analyze: true).
# Falls back to LLM_BASE_URL / LLM_API_KEY if not set.
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=sk-...
VISION_MODEL=gpt-4o-mini

# ─── Embedding Store (Semantic Memory) ──────────────────────────────────────
# Used by semantic-recall for vector-based similarity search.
# Uses the same LLM_BASE_URL / LLM_API_KEY as the primary provider.
# The embedding endpoint (/v1/embeddings) must be supported.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_MAX_ENTRIES=10000

# ─── Server Ports ──────────────────────────────────────────────────────────
# HTTP file server (serves public/)
HTTP_PORT=3000

# WebSocket HUD server
WS_PORT=8080

# ─── TTS (Text-to-Speech) Configuration ──────────────────────────────────
# Default: browser (uses browser SpeechSynthesis API — no server-side config needed)
# Set to "piper" to use Piper neural TTS (requires local Piper installation)

TTS_ENGINE=browser

# ── Piper TTS (optional) ─────────────────────────────────────────────────
# Install Piper: https://github.com/rhasspy/piper/releases
# Download a voice model: https://huggingface.co/rhasspy/piper-voices
# Recommended: en_US-lessac-medium (natural American English)
#
# PIPER_BIN=piper                          # Path to piper binary (default: "piper")
# PIPER_MODEL=/home/user/.local/share/piper-voices/en_US-lessac-medium.onnx
# PIPER_CONFIG=/home/user/.local/share/piper-voices/en_US-lessac-medium.onnx.json
# PIPER_DATA=/usr/share/espeak-ng-data       # espeak-ng data dir (auto-detected)
#
# When TTS_ENGINE=piper and PIPER_MODEL is set, the HUD will show a
# "PIPER" button to switch between Browser and Piper TTS in real-time.

# ─── Web Search Configuration ────────────────────────────────────────────
# M.A.I. can search the web using multiple search engines with automatic fallback.
# Default engine is DuckDuckGo (free, no API key needed, no setup required).

# Search engine: duckduckgo (free), tavily (AI-optimized), searxng (self-hosted)
SEARCH_ENGINE=duckduckgo

# ── Tavily (optional, free tier: 1,000 searches/month) ──────────────────
# Purpose-built for AI agents — returns clean, relevant results.
# Get your free API key from https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ── SearXNG (optional, self-hosted, unlimited) ───────────────────────────
# Self-hosted meta search engine — aggregates Google, Bing, DDG, etc.
# Install: docker run -d -p 8888:8080 searxng/searxng
# SEARXNG_URL=http://localhost:8888

# Max search results per query (default: 8, max: 20)
# SEARCH_MAX_RESULTS=8
